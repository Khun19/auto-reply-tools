#!/bin/sh

# Lightweight Gradle bootstrap for Termux/Android environments.
# AGP 8.5.2 requires Gradle 8.7.
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.7
DIST_NAME="gradle-${GRADLE_VERSION}-bin.zip"
DIST_URL="https://services.gradle.org/distributions/${DIST_NAME}"
GRADLE_HOME="${HOME}/.gradle/wrapper/dists/gradle-${GRADLE_VERSION}"
DIST_DIR="${GRADLE_HOME}/gradle-${GRADLE_VERSION}"
ZIP_FILE="${GRADLE_HOME}/${DIST_NAME}"

if [ ! -x "${DIST_DIR}/bin/gradle" ]; then
    mkdir -p "${GRADLE_HOME}"
    if [ ! -f "${ZIP_FILE}" ]; then
        echo "Downloading Gradle ${GRADLE_VERSION}..."
        if command -v curl >/dev/null 2>&1; then
            curl -fL --retry 3 -o "${ZIP_FILE}" "${DIST_URL}"
        elif command -v wget >/dev/null 2>&1; then
            wget -O "${ZIP_FILE}" "${DIST_URL}"
        else
            echo "ERROR: curl or wget is required to bootstrap Gradle ${GRADLE_VERSION}." >&2
            exit 1
        fi
    fi

    TMP_DIR="${GRADLE_HOME}/.extract"
    rm -rf "${TMP_DIR}"
    mkdir -p "${TMP_DIR}"
    if command -v unzip >/dev/null 2>&1; then
        unzip -q -o "${ZIP_FILE}" -d "${TMP_DIR}"
    else
        echo "ERROR: unzip is required to extract Gradle ${GRADLE_VERSION}." >&2
        exit 1
    fi
    rm -rf "${DIST_DIR}"
    mv "${TMP_DIR}/gradle-${GRADLE_VERSION}" "${DIST_DIR}"
    rm -rf "${TMP_DIR}"
fi

exec "${DIST_DIR}/bin/gradle" --project-dir "${APP_HOME}" "$@"
